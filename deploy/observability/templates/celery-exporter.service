[Unit]
Description=Cinemata Celery exporter
After=network-online.target redis-server.service

[Service]
User=cinematacms-observability
Group=cinematacms-observability
EnvironmentFile=/etc/cinematacms-observability/exporters.env
ExecStart=/opt/cinematacms-observability/celery-exporter/bin/python /opt/cinematacms-observability/celery_exporter_runner.py --host=127.0.0.1 --port=9808 --retry-interval=5
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
