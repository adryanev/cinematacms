[Unit]
Description=Cinemata PostgreSQL exporter
After=network-online.target postgresql.service

[Service]
User=cinematacms-observability
Group=cinematacms-observability
EnvironmentFile=/etc/cinematacms-observability/exporters.env
ExecStart=/opt/cinematacms-observability/bin/postgres_exporter --web.listen-address=127.0.0.1:9187
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
